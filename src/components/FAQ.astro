---
import { faqs } from '../data/site';
---
<section id="faq">
  <div class="wrap narrow">
    <div class="sec-head center rv">
      <span class="eyebrow">Preguntas frecuentes</span>
      <h2>Resolvemos tus <span class="grad-text">dudas</span></h2>
    </div>
    <div class="list">
      {faqs.map((f, i) => (
        <details class="rv" style={`--d:${i * 0.04}s`}>
          <summary><h3>{f.q}</h3><span aria-hidden="true"></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .narrow { max-width: 820px; }
  .list { display: grid; gap: 12px; }
  details { border: 1px solid var(--line); border-radius: 14px; background: var(--card); transition: border-color .3s; }
  details[open] { border-color: rgba(34,211,238,.4); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 24px; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { font-size: 1.05rem; font-weight: 500; font-family: var(--font-b); letter-spacing: 0; }
  summary span { position: relative; width: 16px; height: 16px; flex: none; }
  summary span::before, summary span::after { content: ''; position: absolute; background: var(--cyan); top: 50%; left: 0; width: 100%; height: 2px; transition: transform .3s; }
  summary span::after { transform: rotate(90deg); }
  details[open] summary span::after { transform: rotate(0); }
  details p { padding: 0 24px 22px; color: var(--muted); }
</style>
